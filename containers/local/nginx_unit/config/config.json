{
  "settings": {
    "http": {
      "max_body_size": 52428800
    }
  },

  "listeners": {
    "*:80": {
      "pass": "routes"
    }
  },

  "routes": [
    {
      "match": {
        "host": "rabbitmq.symfony.local"
      },
      "action": {
        "proxy": "http://192.168.219.20:15672"
      }
    },
    {
      "match": {
        "host": "symfony.local",
        "uri": ["*.php", "*.php/*"]
      },
      "action": {
        "pass": "applications/symfony/direct"
      }
    },
    {
      "match": {
        "host": "symfony.local"
      },
      "action": {
        "share": "/var/www/symfony/public$uri",
        "fallback": {
          "pass": "applications/symfony/index"
        }
      }
    }
  ],

  "applications": {
    "symfony": {
      "type": "php 8.3",
      "targets": {
        "direct": {
          "root": "/var/www/symfony/public/"
        },
        "index": {
          "root": "/var/www/symfony/public/",
          "script": "index.php"
        }
      },
      "limits": {
        "requests": 1000,
        "timeout": 600
      },
      "processes": {
        "max": 16,
        "spare": 2,
        "idle_timeout": 60
      },
      "user": "symfony",
      "group": "symfony",
      "environment": {
        "APP_ENV": "dev",
        "APP_DEBUG": "1"
      },
      "options": {
        "file": "/usr/local/etc/php/conf.d/symfony.ini"
      }
    }
  },

  "access_log": {
    "path": "/dev/stdout",
    "format": "$remote_addr - - [$time_local] \"$request_line\" $status $body_bytes_sent \"$header_referer\" \"$header_user_agent\" x-request-id \"$header_x_request_id\" traceparent \"$header_traceparent\" time $request_time"
  }
}